# Backend Settings (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-key
APP_ENV=production

# Database (REQUIRED)
DATABASE_URL=postgresql://lms:REPLACE_PASSWORD@postgres:5432/lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=REPLACE_PASSWORD
POSTGRES_DB=lms

# CORS — comma-separated list of allowed frontend origins.
# Only needed when the browser calls the backend directly; the frontend's
# built-in /api/* proxy makes requests same-origin, so CORS does not apply.
CORS_ORIGINS=https://yourdomain.com

# Frontend: where the Next.js server forwards /api/* requests.
# Read at container start, so it works on platforms that inject env at runtime.
BACKEND_URL=http://backend:8000

# AI Integration (Optional)
OPENAI_API_KEY=your-key-here
YANDEX_API_KEY=your-key-here

# Google Drive Sync (Optional)
GOOGLE_DRIVE_CREDENTIALS_PATH=/app/credentials.json
